# Copy locally to .env (ignored). Configure the deployment host's secret store in production.
# Public API: a SELECT-only role. Require TLS for managed PostgreSQL.
BTB_DATABASE_URL=postgresql://btb_reader:REPLACE@DATABASE_HOST:5432/btb?sslmode=verify-full
# Import/promotion jobs only. NEVER set this on the public API service.
BTB_ADMIN_DATABASE_URL=postgresql://btb_loader:REPLACE@DATABASE_HOST:5432/btb?sslmode=verify-full
BTB_ALLOWED_ORIGINS=https://betweenthebills.com
BTB_POOL_SIZE=8
BTB_RATE_PER_MINUTE=120
BTB_ENABLE_DOCS=0
BTB_S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
BTB_ARCHIVE_BUCKET=btb-research-archive
AWS_ACCESS_KEY_ID=REPLACE
AWS_SECRET_ACCESS_KEY=REPLACE
AWS_DEFAULT_REGION=auto
